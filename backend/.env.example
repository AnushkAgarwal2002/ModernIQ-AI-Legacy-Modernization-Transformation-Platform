# Legacy Modernization Platform — environment configuration
# Copy this file to .env and fill in your Nebius Token Factory values.
# Never commit .env to source control.

# ── Nebius Token Factory – NVIDIA Nemotron (required for all AI features) ────
#
# Step 1: Create an account at https://nebius.com/
# Step 2: Navigate to Token Factory → API Keys
# Step 3: Create a new API key
# Step 4: Set the key value below.
#
NEBIUS_API_KEY=

# ── Nebius Token Factory endpoint (optional override) ─────────────────────────
# Default: https://api.tokenfactory.nebius.com/v1
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ── Model identifier (optional override) ──────────────────────────────────────
# Default: nvidia/Nemotron-3_5-Lightning
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# ── CORS origins (production only) ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave unset (or set to *) for local development.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_ORIGINS=

# ── Optional application settings ────────────────────────────────────────────
# DEBUG=false
